# Copy this file to .env and change the values before the first start.

# Port the website and API run on: http://localhost:3000
PORT=3000

# Long random text used to sign login sessions. Keep it secret.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long a login lasts, in hours
SESSION_HOURS=24

# The first administrator, created automatically the first time the server starts
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@findme.local
ADMIN_PASSWORD=ChangeThisPassword123

# Where data and photos are kept (relative to the project folder)
DB_PATH=data/findme.db
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Login and registration attempts allowed per 15 minutes from one address
AUTH_RATE_LIMIT=20

# Set to "off" only if the page loses its styling behind a strict network (disables the content security policy)
CSP=on

# Use "production" when deployed with HTTPS (makes the login cookie HTTPS-only)
NODE_ENV=development
